{
  "name": "code2node",
  "version": "1.0.0",
  "description": "Visualize your codebase as interactive node graphs",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["code-visualization", "graph", "react-flow", "codebase"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "cors": "^2.8.6",
    "dagre": "^0.8.5",
    "express": "^5.2.1",
    "glob": "^13.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/dagre": "^0.7.53",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
